# Next.js Environment Variables (Optional for Vercel)
# Set your secure custom secret key for JWT session tokens:
ADMIN_JWT_SECRET="ak-associates-secure-cms-secret-key-2026-super-safe"

# Base URL of your live website (e.g. https://akassociates.com.pk)
NEXT_PUBLIC_SITE_URL="https://akassociates.com.pk"

# Google Search Console Verification code (HTML Tag content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
